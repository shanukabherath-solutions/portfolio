# Copy to .env.local for local development. Never commit real values.

# Set to "true" only after you've wired an email provider in src/app/api/contact/route.ts
CONTACT_DELIVERY_ENABLED=false

# Where contact-form messages should be delivered (used by your provider code)
CONTACT_TO_EMAIL=YOUR_EMAIL

# Example provider key (e.g. Resend). Only needed if you use that provider.
RESEND_API_KEY=YOUR_RESEND_API_KEY
